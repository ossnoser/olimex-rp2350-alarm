<?xml version="1.0" encoding="UTF-8"?>
<model version="5.3.0" links="0">
 <documentation>PICO-EVB Rev. A individually addressed manual relay diagnostic. Copied heartbeat plus composed
RelayTestHsm owned by BlinkyAO, and DiagnosticAO. Model is authoritative;
regenerate tracked C++ with tools/qm_codegen.py. Manual on N / off N / off; no relay timer or automatic sequence. Never overlap energized outputs.
SPDX-License-Identifier: GPL-3.0-or-later</documentation>
 <framework name="qpcpp"/>
 <package name="AOs" stereotype="0x02">
  <class name="BlinkyAO" superclass="qpcpp::QActive">
   <documentation>Priority 2 LED active object. Commands update future phase durations;
the armed one-shot timer is never restarted by a duty-cycle command.</documentation>
   <attribute name="timeout_" type="QP::QTimeEvt" visibility="0x02" properties="0x00"/>
   <attribute name="offTicks_" type="unsigned" visibility="0x02" properties="0x00"/>
   <attribute name="onTicks_" type="unsigned" visibility="0x02" properties="0x00"/>
   <attribute name="relay_" type="RelayTestHsm" visibility="0x02" properties="0x00"/>
   <operation name="relayState" type="RelayTest::State" visibility="0x00" properties="0x00">
    <code>return relay_.status();</code>
   </operation>
   <operation name="activeRelay" type="unsigned" visibility="0x00" properties="0x00">
    <code>return relay_.channel();</code>
   </operation>
   <operation name="BlinkyAO" type="" visibility="0x00" properties="0x00">
    <code>: QActive(&amp;initial), timeout_(this, ModelEvents::TIMEOUT_SIG),
  offTicks_(BSP::TICKS_PER_SECOND / 2U),
  onTicks_(BSP::TICKS_PER_SECOND / 2U)

static_assert(BSP::TICKS_PER_SECOND &gt;= 10U);
static_assert(BSP::TICKS_PER_SECOND % 10U == 0U);</code>
   </operation>
   <statechart properties="0x02">
    <initial target="../1/5">
     <action brief="initialize relay controller; start LED off">static_cast&lt;void&gt;(e);
relay_.init(nullptr, 0U);</action>
     <initial_glyph conn="24,4,5,1,0,24">
      <action box="2,4,16,3"/>
     </initial_glyph>
    </initial>
    <state name="running">
     <documentation>Common parent handles duty-cycle commands in either LED phase.</documentation>
     <tran trig="DUTY">
      <action brief="update next phase; keep current timer">auto const tenths = Q_EVT_CAST(ModelEvents::DutyEvent)-&gt;duty.tenths;
onTicks_ = tenths * (BSP::TICKS_PER_SECOND / 10U);
offTicks_ = BSP::TICKS_PER_SECOND - onTicks_;</action>
      <tran_glyph conn="42,20,3,-1,40">
       <action box="0,-3,40,5"/>
      </tran_glyph>
     </tran>
     <tran trig="RELAY_ON">
      <action brief="validate pending channel/session; dispatch">if (Blinky::takeOnRequest(Q_EVT_CAST(ModelEvents::RelayEvent)-&gt;relay)) {
    relay_.dispatch(e, 0U);
}</action>
      <tran_glyph conn="8,70,3,-1,78"><action box="0,-3,76,4"/></tran_glyph>
     </tran>
     <tran trig="FORCE_OFF">
      <action brief="cancel pending; all OFF, reusable IDLE">static_cast&lt;void&gt;(Blinky::cancelPending());
relay_.dispatch(e, 0U);</action>
      <tran_glyph conn="8,80,3,-1,78"><action box="0,-3,76,4"/></tran_glyph>
     </tran>
     <tran trig="SESSION_LOST">
      <action brief="cancel pending; all OFF, no reconnect activation">static_cast&lt;void&gt;(Blinky::cancelPending());
relay_.dispatch(e, 0U);</action>
      <tran_glyph conn="8,90,3,-1,78"><action box="0,-3,76,4"/></tran_glyph>
     </tran>
     <tran trig="RELAY_OFF">
      <action brief="selected OFF; preserve unrelated relay">relay_.dispatch(e, 0U);</action>
      <tran_glyph conn="8,100,3,-1,78"><action box="0,-3,76,4"/></tran_glyph>
     </tran>
     <state name="off">
      <entry>BSP::setLed(false);
timeout_.armX(offTicks_);</entry>
      <tran trig="TIMEOUT" target="../../6">
       <tran_glyph conn="38,38,3,1,16">
        <action box="2,-3,14,3"/>
       </tran_glyph>
      </tran>
      <state_glyph node="10,28,28,24">
       <entry box="1,3,26,8"/>
      </state_glyph>
     </state>
     <state name="on">
      <entry>BSP::setLed(true);
timeout_.armX(onTicks_);</entry>
      <tran trig="TIMEOUT" target="../../5">
       <tran_glyph conn="54,47,3,1,-16">
        <action box="-14,1,14,3"/>
       </tran_glyph>
      </tran>
      <state_glyph node="54,28,28,24">
       <entry box="1,3,26,8"/>
      </state_glyph>
     </state>
     <state_glyph node="4,12,84,98"/>
    </state>
    <state_diagram size="94,116"/>
   </statechart>
  </class>
  <class name="DiagnosticAO" superclass="qpcpp::QActive">
   <documentation>Priority 1 diagnostic. SAMPLE reads inputs and performs bounded reporting;
USB_SERVICE drains transport work without sampling or formatting.</documentation>
   <attribute name="session_" type="Report::Session" visibility="0x02" properties="0x00"/>
   <attribute name="port_" type="DiagnosticPort" visibility="0x02" properties="0x00"/>
   <attribute name="sample_" type="QP::QTimeEvt" visibility="0x02" properties="0x00"/>
   <operation name="DiagnosticAO" type="" visibility="0x00" properties="0x00">
    <code>: QActive(&amp;initial), sample_(this, ModelEvents::SAMPLE_SIG)</code>
   </operation>
   <statechart properties="0x02">
    <initial target="../1">
     <action brief="arm 20 ms sample">static_cast&lt;void&gt;(e);
static_assert(BSP::TICKS_PER_SECOND % 50U == 0U);
constexpr unsigned SAMPLE_TICKS = BSP::TICKS_PER_SECOND / 50U;
sample_.armX(SAMPLE_TICKS, SAMPLE_TICKS);</action>
     <initial_glyph conn="18,4,5,1,0,12">
      <action box="3,3,44,5"/>
     </initial_glyph>
    </initial>
    <state name="active">
     <tran trig="SAMPLE">
      <action brief="sample inputs; bounded commands and reporting">if (!session_.poll(port_)) {
    Q_onError("diagnostic_report", 1);
}</action>
      <tran_glyph conn="10,28,3,-1,82">
       <action box="0,-4,80,6"/>
      </tran_glyph>
     </tran>
     <tran trig="USB_SERVICE">
      <action brief="release coalescing flag; service USB only">DiagnosticSupport::serviceUsb();</action>
      <tran_glyph conn="10,42,3,-1,82">
       <action box="0,-4,80,6"/>
      </tran_glyph>
     </tran>
     <state_glyph node="6,16,96,36"/>
    </state>
    <state_diagram size="108,58"/>
   </statechart>
  </class>
  <class name="RelayTestHsm" superclass="qpcpp::QHsm">
   <documentation>Owned by BlinkyAO. One manually selected relay latched ON until OFF/loss.
No automatic timeout, sequence, input linkage or within-boot lockout.</documentation>
   <attribute name="controlState_" type="RelayTest::State" visibility="0x02" properties="0x00"/>
   <attribute name="currentRelay_" type="unsigned" visibility="0x02" properties="0x00"/>
   <operation name="channel" type="unsigned" visibility="0x00" properties="0x00">
    <code>return currentRelay_;</code>
   </operation>
   <operation name="RelayTestHsm" type="" visibility="0x00" properties="0x00">
    <code>: QHsm(&amp;initial), controlState_(RelayTest::State::Idle), currentRelay_(0U)</code>
   </operation>
   <operation name="status" type="RelayTest::State" visibility="0x00" properties="0x00">
    <code>return controlState_;</code>
   </operation>
   <statechart properties="0x02">
    <initial target="../1/2">
     <action brief="boot IDLE; outputs OFF">static_cast&lt;void&gt;(e);</action>
     <initial_glyph conn="20,4,5,1,0,24"><action box="3,3,30,4"/></initial_glyph>
    </initial>
    <state name="operational">
     <tran trig="FORCE_OFF" target="../2">
      <tran_glyph conn="24,16,5,1,0,12"><action box="-20,3,18,3"/></tran_glyph>
     </tran>
     <tran trig="SESSION_LOST" target="../2">
      <tran_glyph conn="44,16,5,1,0,38,-4"><action box="2,3,30,3"/></tran_glyph>
     </tran>
     <state name="idle">
      <entry>Carrier::forceRelaysOff();
controlState_ = RelayTest::State::Idle;
currentRelay_ = 0U;</entry>
      <tran trig="RELAY_ON" target="../../3">
       <action brief="select N">currentRelay_ = Q_EVT_CAST(ModelEvents::RelayEvent)-&gt;relay;</action>
       <tran_glyph conn="40,40,3,1,24"><action box="0,-4,24,4"/></tran_glyph>
      </tran>
      <state_glyph node="8,28,32,50"><entry box="1,3,30,14"/></state_glyph>
     </state>
     <state name="on">
      <entry>if (!Carrier::activateRelay(currentRelay_)) {
    Q_onError("relay_channel", 1);
}
controlState_ = RelayTest::State::On;</entry>
      <exit>Carrier::forceRelaysOff();</exit>
      <tran trig="RELAY_OFF">
       <choice target="../../../2">
        <guard brief="matching relay">currentRelay_ == Q_EVT_CAST(ModelEvents::RelayEvent)-&gt;relay</guard>
        <choice_glyph conn="52,60,3,1,-12"><action box="-10,3,20,4"/></choice_glyph>
       </choice>
       <tran_glyph conn="64,60,3,-1,-12"><action box="-20,-4,20,4"/></tran_glyph>
      </tran>
      <state_glyph node="64,28,60,50"><entry box="1,3,58,16"/><exit box="1,30,58,8"/></state_glyph>
     </state>
     <state_glyph node="4,16,126,70"/>
    </state>
    <state_diagram size="136,92"/>
   </statechart>
  </class>
 </package>
 <directory name="../generated">
